<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="400" height="480" role="img" aria-label="Electric Store logo" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1E3A8A"/>
      <stop offset="1" stop-color="#0F172A"/>
    </linearGradient>
    <linearGradient id="bolt" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDE047"/>
      <stop offset="1" stop-color="#F59E0B"/>
    </linearGradient>
  </defs>
  <circle cx="200" cy="200" r="170" fill="url(#bg)"/>
  <circle cx="200" cy="200" r="170" fill="none" stroke="#FACC15" stroke-width="8"/>
  <circle cx="200" cy="200" r="148" fill="none" stroke="#FACC15" stroke-width="2" stroke-dasharray="4 8" opacity="0.7"/>
  <path d="M225 60 L120 225 H190 L165 340 L285 160 H210 Z" fill="url(#bolt)" stroke="#FFFFFF" stroke-width="4" stroke-linejoin="round"/>
  <text x="200" y="420" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="46" font-weight="800" fill="#0F172A" letter-spacing="4">ELECTRIC</text>
  <text x="200" y="460" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="600" fill="#F59E0B" letter-spacing="14">STORE</text>
</svg>
